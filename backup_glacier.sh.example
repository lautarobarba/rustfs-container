#!/usr/bin/env bash
# Backup de buckets de RustFS a AWS S3 Glacier Deep Archive.
# Ver BACKUPS.md para la configuración.

#========== CONFIG ==========
# Buckets a respaldar (separados por espacio)
BUCKETS="mi-bucket otro-bucket"

# Bucket y carpeta (prefijo) de destino en S3
S3_BUCKET=mi-bucket-de-backups
S3_PREFIX=rustfs/$(hostname)

# Clase de almacenamiento: DEEP_ARCHIVE es la más barata y durable
S3_STORAGE_CLASS=DEEP_ARCHIVE

# Perfil de credenciales de AWS CLI (ver ~/.aws/credentials)
AWS_PROFILE=rustfs-backup

# Servicio con el cliente S3 definido en compose.yaml
SERVICE_NAME=backup
#======== END CONFIG ========

set -o pipefail
export PATH=/usr/local/bin:/usr/bin:/bin:${PATH}
export AWS_PROFILE

SCRIPT_PATH=$(realpath "$0")
WORKDIR=$(dirname "${SCRIPT_PATH}")
LOG_FILE=${WORKDIR}/backup.log
LOCAL_DIR=${WORKDIR}/backups
FECHA=$(date +%Y%m%d-%H%M)

log() {
    echo "[$(date)] $*" >>"${LOG_FILE}"
}

cd "${WORKDIR}" || exit 1
mkdir -p "${LOCAL_DIR}"
log "========== Comenzando script Backup (Glacier) - RUSTFS =========="

ERRORES=0
for BUCKET in ${BUCKETS}; do
    DIR_NAME=${BUCKET}-${FECHA}
    DIR=${LOCAL_DIR}/${DIR_NAME}
    FILE_NAME=${DIR_NAME}.tar.gz
    FILE=${LOCAL_DIR}/${FILE_NAME}
    S3_URI=s3://${S3_BUCKET}/${S3_PREFIX}/${BUCKET}/${FILE_NAME}

    log ">> Descargando el bucket ${BUCKET} a ${DIR}"
    mkdir -p "${DIR}"
    if ! docker compose --progress quiet run --rm -T "${SERVICE_NAME}" \
        s3 sync "s3://${BUCKET}" "/backups/${DIR_NAME}" --only-show-errors \
        >>"${LOG_FILE}" 2>&1; then
        log "STATUS: ERROR al descargar ${BUCKET}"
        rm -rf "${DIR}"
        ERRORES=$((ERRORES + 1))
        continue
    fi
    log "STATUS: OK"

    log ">> Comprimiendo ${DIR} en ${FILE}"
    tar -czf "${FILE}" -C "${DIR}" . 2>>"${LOG_FILE}"
    STATUS=$?
    rm -rf "${DIR}"
    if [ ${STATUS} -ne 0 ]; then
        log "STATUS: ERROR al comprimir ${BUCKET}"
        rm -f "${FILE}"
        ERRORES=$((ERRORES + 1))
        continue
    fi
    log "STATUS: OK"

    log ">> Subiendo ${FILE} a ${S3_URI} (${S3_STORAGE_CLASS})"
    if ! aws s3 cp "${FILE}" "${S3_URI}" --storage-class "${S3_STORAGE_CLASS}" --only-show-errors 2>>"${LOG_FILE}"; then
        log "STATUS: ERROR al subir ${BUCKET}, el backup queda en ${FILE}"
        ERRORES=$((ERRORES + 1))
        continue
    fi
    log "STATUS: OK"

    rm -f "${FILE}"
done

if [ ${ERRORES} -ne 0 ]; then
    log "STATUS: ERROR - ${ERRORES} bucket(s) no se pudieron respaldar"
    log "STATUS: BACKUP INCOMPLETO"
    log "------------------------------------"
    exit 1
fi
log "STATUS: BACKUP FINALIZADO CORRECTAMENTE"
log "------------------------------------"
exit 0
